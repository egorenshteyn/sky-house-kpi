# Local defaults for Sky House KPI Tracker.
# Copy to .env.local and fill in real secrets. Never commit .env.local.

# Hospitable Public API Personal Access Token. Server-only; never expose with NEXT_PUBLIC_.
HOSPITABLE_API_TOKEN=
# Optional comma-separated Hospitable property UUIDs. If blank, sync uses all properties visible to the token.
HOSPITABLE_PROPERTY_IDS=
HOSPITABLE_DEFAULT_CHANNEL=Hospitable

# Legacy Lodgify config retained for rollback/reference.
LODGIFY_API_KEY=
LODGIFY_DEFAULT_CHANNEL=Lodgify
